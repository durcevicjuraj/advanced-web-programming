extends ../layout

block content
  h1= title
  h2 Project: #{project.name}

  form(method="post", action="/projects/#{project._id}/addmember")
    div
      label(for="memberId") Select Team Member:
      br
      select(name="memberId", required)
        option(value="") -- Select User --
        each user in users
          option(value=user._id)= user.username

    br
    div
      button(type="submit") Add Member
      = ' '
      a(href="/projects/#{project._id}") Cancel
